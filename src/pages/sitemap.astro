---
import BaseLayout from '../layouts/BaseLayout.astro';
import fs from 'fs';
import path from 'path';

// Read all VPS provider pages
const vpsDir = path.resolve('src/pages/vps');
const vpsFiles = fs.readdirSync(vpsDir).filter(f => f.endsWith('.astro') && f !== 'index.astro');
const vpsPages = vpsFiles.map(f => {
  const slug = f.replace('.astro', '');
  const content = fs.readFileSync(path.join(vpsDir, f), 'utf8');
  const m = content.match(/^title:\s*["']?([^"'\n]+)/m);
  const title = m ? m[1].trim().replace(/^["']|["']$/g, '') : slug.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
  return { slug, title };
});

// Read all blog posts
const blogDir = path.resolve('src/pages/blog');
const blogFiles = fs.readdirSync(blogDir).filter(f => f.endsWith('.astro') && f !== 'index.astro');
const blogPosts = blogFiles.map(f => {
  const slug = f.replace('.astro', '');
  const content = fs.readFileSync(path.join(blogDir, f), 'utf8');
  const titleMatch = content.match(/^title:\s*["']?([^"'\n]+)/m);
  const dateMatch = content.match(/^pubDate:\s*["']?([^"'\n]+)/m);
  const title = titleMatch ? titleMatch[1].trim().replace(/^["']|["']$/g, '') : slug.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
  const date = dateMatch ? dateMatch[1].trim().replace(/^["']|["']$/g, '') : '';
  return { slug, title, date };
}).sort((a, b) => (b.date || '').localeCompare(a.date || ''));

const totalPages = 1 + vpsPages.length + blogPosts.length + 4; // home + 4 main pages
---

<BaseLayout
  title="Sitemap - All VPS Reviews & Articles | VPSTier.com"
  description={`Complete sitemap of VPSTier.com: ${totalPages} pages including ${vpsPages.length} VPS provider reviews and ${blogPosts.length} articles and guides.`}
>
  <section class="hero-gradient">
    <div class="max-w-6xl mx-auto px-6 py-16">
      <div class="badge badge-orange mb-4 w-fit">
        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="4"/></svg>
        Sitemap
      </div>
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-3">All Pages on VPSTier.com</h1>
      <p class="text-gray-400 text-lg">{totalPages} pages total — {vpsPages.length} VPS reviews and {blogPosts.length} articles.</p>
    </div>
  </section>

  <!-- Main Pages -->
  <section class="border-t border-white/5">
    <div class="max-w-6xl mx-auto px-6 py-12">
      <h2 class="section-heading mb-6">Main Pages</h2>
      <div class="grid md:grid-cols-2 gap-3">
        <a href="/" class="group flex items-center gap-3 p-4 bg-[#111] border border-white/5 rounded-xl hover:border-orange-500/30 transition-colors">
          <div class="w-8 h-8 rounded-lg bg-orange-500/20 flex items-center justify-center flex-shrink-0">
            <svg class="w-4 h-4 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
          </div>
          <div>
            <div class="text-white font-medium group-hover:text-orange-400 transition-colors">Home</div>
            <div class="text-gray-500 text-sm">Browse all VPS reviews</div>
          </div>
        </a>
        <a href="/vps/" class="group flex items-center gap-3 p-4 bg-[#111] border border-white/5 rounded-xl hover:border-orange-500/30 transition-colors">
          <div class="w-8 h-8 rounded-lg bg-orange-500/20 flex items-center justify-center flex-shrink-0">
            <svg class="w-4 h-4 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2"/></svg>
          </div>
          <div>
            <div class="text-white font-medium group-hover:text-orange-400 transition-colors">All VPS Reviews</div>
            <div class="text-gray-500 text-sm">Browse all VPS providers</div>
          </div>
        </a>
        <a href="/blog/" class="group flex items-center gap-3 p-4 bg-[#111] border border-white/5 rounded-xl hover:border-orange-500/30 transition-colors">
          <div class="w-8 h-8 rounded-lg bg-orange-500/20 flex items-center justify-center flex-shrink-0">
            <svg class="w-4 h-4 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
          </div>
          <div>
            <div class="text-white font-medium group-hover:text-orange-400 transition-colors">Blog</div>
            <div class="text-gray-500 text-sm">Articles &amp; buying guides</div>
          </div>
        </a>
        <a href="/compare/" class="group flex items-center gap-3 p-4 bg-[#111] border border-white/5 rounded-xl hover:border-orange-500/30 transition-colors">
          <div class="w-8 h-8 rounded-lg bg-orange-500/20 flex items-center justify-center flex-shrink-0">
            <svg class="w-4 h-4 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
          </div>
          <div>
            <div class="text-white font-medium group-hover:text-orange-400 transition-colors">Compare VPS</div>
            <div class="text-gray-500 text-sm">Side-by-side comparisons</div>
          </div>
        </a>
        <a href="/promo-codes/" class="group flex items-center gap-3 p-4 bg-[#111] border border-white/5 rounded-xl hover:border-orange-500/30 transition-colors">
          <div class="w-8 h-8 rounded-lg bg-orange-500/20 flex items-center justify-center flex-shrink-0">
            <svg class="w-4 h-4 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
          </div>
          <div>
            <div class="text-white font-medium group-hover:text-orange-400 transition-colors">Promo Codes</div>
            <div class="text-gray-500 text-sm">Active VPS deals &amp; coupons</div>
          </div>
        </a>
        <a href="/about/" class="group flex items-center gap-3 p-4 bg-[#111] border border-white/5 rounded-xl hover:border-orange-500/30 transition-colors">
          <div class="w-8 h-8 rounded-lg bg-orange-500/20 flex items-center justify-center flex-shrink-0">
            <svg class="w-4 h-4 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <div>
            <div class="text-white font-medium group-hover:text-orange-400 transition-colors">About</div>
            <div class="text-gray-500 text-sm">About VPSTier &amp; mission</div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- VPS Providers -->
  <section class="border-t border-white/5">
    <div class="max-w-6xl mx-auto px-6 py-12">
      <h2 class="section-heading mb-2">VPS Provider Reviews ({vpsPages.length})</h2>
      <p class="text-gray-400 text-sm mb-6">Independent reviews with commission rates and real-world testing.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-x-6 gap-y-2">
        {vpsPages.map((p) => (
          <a href={`/vps/${p.slug}/`} class="group flex items-center gap-2 text-gray-400 hover:text-orange-400 transition-colors py-1.5">
            <svg class="w-3 h-3 text-orange-500/60 group-hover:text-orange-400 flex-shrink-0" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3"/></svg>
            <span class="text-sm">{p.title}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Blog Posts -->
  <section class="border-t border-white/5">
    <div class="max-w-6xl mx-auto px-6 py-12">
      <h2 class="section-heading mb-2">Articles &amp; Guides ({blogPosts.length})</h2>
      <p class="text-gray-400 text-sm mb-6">Reviews, comparisons, buying guides, and outage postmortems.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-x-6 gap-y-2">
        {blogPosts.map((post) => (
          <a href={`/blog/${post.slug}/`} class="group flex items-center gap-2 text-gray-400 hover:text-orange-400 transition-colors py-1.5">
            <svg class="w-3 h-3 text-orange-500/60 group-hover:text-orange-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <span class="text-sm">{post.title}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- XML Sitemaps -->
  <section class="border-t border-white/5">
    <div class="max-w-6xl mx-auto px-6 py-12">
      <h2 class="section-heading mb-4">XML Sitemaps (for search engines)</h2>
      <p class="text-gray-400 text-sm mb-4">Submit these to Google Search Console &amp; Bing Webmaster Tools.</p>
      <div class="space-y-2">
        <a href="/sitemap-v2.xml" class="block text-orange-400 hover:text-orange-300 transition-colors font-mono text-sm">https://vpstier.com/sitemap-v2.xml</a>
        <a href="/sitemap-index.xml" class="block text-orange-400 hover:text-orange-300 transition-colors font-mono text-sm">https://vpstier.com/sitemap-index.xml</a>
      </div>
    </div>
  </section>
</BaseLayout>