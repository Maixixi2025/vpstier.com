  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://vpstier.com"},
      {"@type": "ListItem", "position": 2, "name": "VPS Deals", "item": "https://vpstier.com/promo-codes/"}
