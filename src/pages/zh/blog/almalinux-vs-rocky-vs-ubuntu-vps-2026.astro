          <tr><td><a href="/vps/racknerd">RackNerd</a></td><td>✅ 一键</td><td>✅ 自定义 ISO 上传</td><td>✅ 自定义 ISO 上传</td><td>~3-5 分钟</td></tr>
          <tr><td><a href="/vps/vultr">Vultr</a></td><td>✅ Marketplace + ISO</td><td>✅ Marketplace + ISO</td><td>✅ Marketplace + ISO</td><td>~60 秒</td></tr>
          <tr><td><a href="/vps/digitalocean">DigitalOcean</a></td><td>✅ Marketplace + ISO</td><td>✅ Marketplace + ISO</td><td>✅ Marketplace + ISO</td><td>~60 秒</td></tr>
