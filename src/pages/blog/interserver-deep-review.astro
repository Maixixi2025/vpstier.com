          <tr><td>CPU</td><td>Intel Xeon</td><td>Intel Xeon</td><td>Intel Xeon</td></tr>
          <tr><td>Datacenter</td><td>Los Angeles / NJ</td><td>Multi-location</td><td>Global</td></tr>
          <tr><td>Commission</td><td>$100/sale</td><td>$80/sale</td><td>$10-100/sale</td></tr>
        </tbody>
