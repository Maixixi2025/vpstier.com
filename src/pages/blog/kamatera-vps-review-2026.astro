          <tr><td>Datacenters</td><td>14 (6 EU)</td><td>15 (3 EU)</td><td>25 (3 EU)</td><td><a href="https://www.vultr.com/?ref=9148877" target="_blank" rel="noopener">32 (5 EU)</a></td></tr>
          <tr><td>Free trial</td><td>30 days, no card</td><td>60 days (team, $200 deposit)</td><td>None</td><td>$300 credit</td></tr>
          <tr><td>Custom config</td><td>✅ Full</td><td>⚠️ Limited</td><td>⚠️ Limited</td><td>⚠️ Limited</td></tr>
          <tr><td>Hourly billing</td><td>✅ $0.005/hr</td><td>✅ Yes</td><td>✅ Yes</td><td>✅ Yes</td></tr>
          <tr><td>Dedicated CPU</td><td>✅ Type D</td><td>⚠️ Premium tier</td><td>⚠️ Dedicated plan</td><td>✅ Yes</td></tr>
          <tr><td>24/7 support</td><td>✅ Included</td><td>✅ Included</td><td>✅ Included</td><td>✅ Included</td></tr>
