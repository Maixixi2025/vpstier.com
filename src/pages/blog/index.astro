  </section>

  <section class="max-w-6xl mx-auto px-6 py-16">
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map(post => (
        <a href={`/blog/${post.slug}`} class="group bg-[#111] border border-white/5 rounded-2xl p-6 card-hover block">
          <div class="flex items-center gap-2 mb-3">
            <span class="badge badge-orange text-xs">{post.category}</span>
            <span class="text-gray-600 text-xs">{post.date}</span>
          </div>
          <h2 class="text-lg font-bold text-white mb-3 group-hover:text-orange-400 transition-colors">
            {post.title}
          </h2>
          <p class="text-gray-500 text-sm mb-4 line-clamp-3">{post.excerpt}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
