---
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = [
  {
    slug: 'racknerd-vs-vultr-2025',
    title: 'RackNerd vs Vultr: Which VPS is Better for AI Agents',
    date: 'May 21, 2025',
    category: 'Comparison',
    excerpt: 'Deep dive comparison focusing on AI agent workloads. CPU PassMark, network latency, and real inference speeds tested.'
  },
  {
    slug: 'cloudways-vs-digitalocean-2025',
    title: 'Cloudways vs DigitalOcean: Managed vs Unmanaged',
    date: 'May 20, 2025',
    category: 'Comparison',
    excerpt: 'Cloudways offers managed hosting while DigitalOcean gives raw infrastructure. Which is better for beginners?'
  }
];
---

<BaseLayout title="Blog - VPSTier.com | VPS Reviews & Comparison Articles">
  <section class="hero-gradient border-b border-white/5">
    <div class="max-w-6xl mx-auto px-6 py-16">
      <h1 class="text-4xl font-bold text-white mb-4">Blog</h1>
      <p class="text-gray-400">VPS comparisons, commission benchmarks, and hosting insights — updated weekly.</p>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-16">
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map(post => (
        <a href={`/blog/${post.slug}`} class="group bg-[#111] border border-white/5 rounded-2xl p-6 card-hover block">
          <div class="flex items-center gap-2 mb-3">
            <span class="badge badge-orange text-xs">{post.category}</span>
            <span class="text-gray-600 text-xs">{post.date}</span>
          </div>
          <h2 class="text-lg font-bold text-white mb-3 group-hover:text-orange-400 transition-colors">
            {post.title}
          </h2>
          <p class="text-gray-500 text-sm mb-4 line-clamp-3">{post.excerpt}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
