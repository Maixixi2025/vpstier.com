      <tr class="border-b border-gray-800"><td class="py-3 pr-4 text-white">PRO-2-M</td><td class="py-3 pr-4 text-gray-300">4 vCPU</td><td class="py-3 pr-4 text-gray-300">8 GB</td><td class="py-3 pr-4 text-gray-300">125 GB NVMe</td><td class="py-3 pr-4 text-gray-300">500 Mbps</td><td class="py-3 pr-4 text-orange-400">€17.49/mo</td></tr>
      <tr class="border-b border-gray-800"><td class="py-3 pr-4 text-white">STORE-2-XS</td><td class="py-3 pr-4 text-gray-300">1 vCPU</td><td class="py-3 pr-4 text-gray-300">2 GB</td><td class="py-3 pr-4 text-gray-300">250 GB NVMe</td><td class="py-3 pr-4 text-gray-300">10 Gbit/s</td><td class="py-3 pr-4 text-orange-400">€7.99/mo</td></tr>
