      <tr class="border-b border-gray-800"><td class="py-3 pr-4 text-white">START-2-M</td><td class="py-3 pr-4 text-gray-300">3 vCPU</td><td class="py-3 pr-4 text-gray-300">4 GB</td><td class="py-3 pr-4 text-gray-300">40 GB NVMe</td><td class="py-3 pr-4 text-gray-300">300 Mbps</td><td class="py-3 pr-4 text-orange-400">€14.49/mo</td></tr>
