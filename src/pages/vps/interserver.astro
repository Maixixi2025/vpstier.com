---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Interserver Review - VPSTier.com" description="Interserver has been a reliable choice for over 25 years. No contracts, no hidden fees, and consistent pricing make it ideal for developers who want predictability. Their price lock guarantee means your renewal won't suddenly spike.">
  
  <!-- Hero -->
  <section class="hero-gradient">
    <div class="max-w-6xl mx-auto px-6 py-12">
      <a href="/vps" class="text-gray-500 hover:text-orange-400 text-sm mb-6 inline-flex items-center gap-1 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        Back to VPS Reviews
      </a>
      
      <div class="flex flex-wrap items-start justify-between gap-6">
        <div>
          <h1 class="text-4xl font-bold text-white mb-3">Interserver Review</h1>
          <div class="flex flex-wrap gap-4 text-sm text-gray-400 mb-4">
            <span>Commission: <strong class="text-orange-400">$100/sale</strong></span>
            <span>Cookie: <strong>120 days</strong></span>
          </div>
          <div class="flex items-center gap-2">
            <div class="flex">
              <svg class="w-5 h-5 text-orange-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg><svg class="w-5 h-5 text-orange-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg><svg class="w-5 h-5 text-orange-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg><svg class="w-5 h-5 text-orange-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              <svg class="w-5 h-5 text-gray-600" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            </div>
            <span class="text-white font-bold">4.5/5</span>
          </div>
        </div>
        <a href="https://interserver.internative.space/?page=16719&Ref_Group=vpstier" target="_blank" rel="noopener" class="btn-primary">
          Visit Interserver →
        </a>
      </div>
    </div>
  </section>

  <!-- Content -->
  <section class="max-w-6xl mx-auto px-6 py-12">
    <div class="grid lg:grid-cols-3 gap-8">
      
      <!-- Main Content -->
      <div class="lg:col-span-2 space-y-8">
        
        <!-- Overview -->
        <div class="bg-[#111] border border-white/5 rounded-2xl p-8">
          <h2 class="text-xl font-bold text-white mb-4">Overview</h2>
          <p class="text-gray-400 leading-relaxed">Interserver has been a reliable choice for over 25 years. No contracts, no hidden fees, and consistent pricing make it ideal for developers who want predictability. Their price lock guarantee means your renewal won't suddenly spike.</p>
          <p class="text-gray-500 mt-3">Starting at <span class="text-white font-medium">$6/mo</span></p>
        </div>

        <!-- Pros & Cons -->
        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-[#111] border border-green-500/10 rounded-2xl p-6">
            <h3 class="text-lg font-bold text-green-400 mb-4 flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Pros
            </h3>
            <ul class="space-y-3">
              <li class="text-gray-300 text-sm flex items-start gap-2"><span class="text-green-400 mt-0.5">✓</span>$100 flat commission per sale</li><li class="text-gray-300 text-sm flex items-start gap-2"><span class="text-green-400 mt-0.5">✓</span>120-day cookie — longest in the industry</li><li class="text-gray-300 text-sm flex items-start gap-2"><span class="text-green-400 mt-0.5">✓</span>No long-term contracts required</li><li class="text-gray-300 text-sm flex items-start gap-2"><span class="text-green-400 mt-0.5">✓</span>Price lock guarantee — renewals stay the same</li><li class="text-gray-300 text-sm flex items-start gap-2"><span class="text-green-400 mt-0.5">✓</span>Full root access on all plans</li><li class="text-gray-300 text-sm flex items-start gap-2"><span class="text-green-400 mt-0.5">✓</span>Windows VPS available</li>
            </ul>
          </div>
          <div class="bg-[#111] border border-red-500/10 rounded-2xl p-6">
            <h3 class="text-lg font-bold text-red-400 mb-4 flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
              Cons
            </h3>
            <ul class="space-y-3">
              <li class="text-gray-300 text-sm flex items-start gap-2"><span class="text-red-400 mt-0.5">−</span>No managed WordPress option</li><li class="text-gray-300 text-sm flex items-start gap-2"><span class="text-red-400 mt-0.5">−</span>UI feels dated compared to newer providers</li>
            </ul>
          </div>
        </div>

        <!-- Commission Info -->
        <div class="bg-gradient-to-br from-orange-500/10 to-orange-600/5 border border-orange-500/20 rounded-2xl p-8">
          <h2 class="text-xl font-bold text-white mb-4">Affiliate Commission</h2>
          <div class="flex items-baseline gap-3 mb-3">
            <span class="text-4xl font-bold text-orange-400">$100/sale</span>
            <span class="text-gray-500">per sale</span>
          </div>
          <div class="flex items-center gap-2 text-sm text-gray-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Cookie window: 120 days
          </div>
        </div>

      </div>

      <!-- Sidebar -->
      <div class="lg:col-span-1">
        <div class="bg-[#111] border border-white/5 rounded-2xl p-6 sticky top-24">
          <div class="text-center mb-6">
            <div class="text-5xl font-bold text-white mb-2">4.5<span class="text-gray-500 text-2xl">/5</span></div>
            <div class="text-gray-500 text-sm">Developer Rating</div>
          </div>
          
          <a href="https://interserver.internative.space/?page=16719&Ref_Group=vpstier" target="_blank" rel="noopener" class="btn-primary w-full text-center block mb-4">
            Sign Up via Affiliate Link
          </a>
          
          <div class="text-center text-gray-600 text-xs">
            We earn a commission when you sign up. This doesn't affect our review.
          </div>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
