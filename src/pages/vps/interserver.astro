---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Interserver Review - VPSTier.com" description="Interserver has been a reliable choice for over 25 years. No contracts, no hidden fees, and consistent pricing make it ideal for developers who want predictability.">
  <section class="max-w-4xl mx-auto px-6 py-16">
    <a href="/vps" class="text-gray-500 hover:text-orange-500 text-sm mb-6 block">← Back to VPS Reviews</a>
    
    <div class="flex flex-wrap gap-4 items-start justify-between mb-8">
      <div>
        <h1 class="text-3xl font-bold mb-2">Interserver Review</h1>
        <div class="flex gap-4 text-sm text-gray-400">
          <span>Commission: <strong class="text-orange-500">$100/sale</strong></span>
          <span>Cookie: <strong>120 days</strong></span>
        </div>
      </div>
      <a href="https://interserver.internative.space/?page=16719&Ref_Group=vpstier" target="_blank" rel="noopener" 
         class="bg-orange-600 hover:bg-orange-500 text-white px-6 py-3 rounded-lg font-medium transition">
        Visit Interserver →
      </a>
    </div>

    <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 mb-8">
      <div class="flex items-center gap-4 mb-4">
        <span class="text-2xl font-bold">4.5/5</span>
        <span class="text-gray-500">Developer Rating</span>
      </div>
      <p class="text-gray-300">Interserver has been a reliable choice for over 25 years. No contracts, no hidden fees, and consistent pricing make it ideal for developers who want predictability.</p>
      <p class="text-gray-400 mt-2">Starting at $6/mo</p>
    </div>

    <div class="grid md:grid-cols-2 gap-8 mb-8">
      <div>
        <h2 class="text-xl font-bold mb-4 text-green-400">Pros</h2>
        <ul class="space-y-2">
          <li class="text-gray-300 text-sm">✅ $100 flat commission per sale</li><li class="text-gray-300 text-sm">✅ 120-day cookie window</li><li class="text-gray-300 text-sm">✅ No long-term contracts required</li><li class="text-gray-300 text-sm">✅ Price lock guarantee</li><li class="text-gray-300 text-sm">✅ Full root access on all plans</li>
        </ul>
      </div>
      <div>
        <h2 class="text-xl font-bold mb-4 text-red-400">Cons</h2>
        <ul class="space-y-2">
          <li class="text-gray-300 text-sm">⚠️ No managed WordPress option</li><li class="text-gray-300 text-sm">⚠️ UI feels dated compared to newer providers</li>
        </ul>
      </div>
    </div>

    <div class="border-t border-gray-800 pt-8">
      <a href="https://interserver.internative.space/?page=16719&Ref_Group=vpstier" target="_blank" rel="noopener"
         class="block text-center bg-orange-600 hover:bg-orange-500 text-white px-8 py-4 rounded-lg font-bold transition">
        Sign Up via Our Affiliate Link ($100/sale)
      </a>
      <p class="text-center text-gray-500 text-xs mt-3">
        We earn a commission when you sign up through our link. This doesn't affect our review.
      </p>
    </div>
  </section>
</BaseLayout>
