    <div class="flex flex-wrap gap-4 items-start justify-between mb-8">
      <div>
        <h1 class="text-3xl font-bold mb-2">Netcup Review</h1>
        <div class="flex flex-wrap gap-4 text-sm text-gray-400">
          <span>Compute: <strong class="text-orange-500">KVM, DDR5 ECC</strong></span>
          <span>Regions: <strong>5 (EU + US + SG)</strong></span>
