---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Cloudways Review - VPSTier.com" description="Cloudways offers managed cloud hosting across 5 providers. Perfect for developers who want the power of cloud providers without the management headache.">
  <section class="max-w-4xl mx-auto px-6 py-16">
    <a href="/vps" class="text-gray-500 hover:text-orange-500 text-sm mb-6 block">← Back to VPS Reviews</a>
    
    <div class="flex flex-wrap gap-4 items-start justify-between mb-8">
      <div>
        <h1 class="text-3xl font-bold mb-2">Cloudways Review</h1>
        <div class="flex gap-4 text-sm text-gray-400">
          <span>Commission: <strong class="text-orange-500">$50-175/sale</strong></span>
          <span>Cookie: <strong>90 days</strong></span>
        </div>
      </div>
      <a href="https://www.cloudways.com/en/partners.php?id=131662" target="_blank" rel="noopener" 
         class="bg-orange-600 hover:bg-orange-500 text-white px-6 py-3 rounded-lg font-medium transition">
        Visit Cloudways →
      </a>
    </div>

    <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 mb-8">
      <div class="flex items-center gap-4 mb-4">
        <span class="text-2xl font-bold">4.3/5</span>
        <span class="text-gray-500">Developer Rating</span>
      </div>
      <p class="text-gray-300">Cloudways offers managed cloud hosting across 5 providers. Perfect for developers who want the power of cloud providers without the management headache.</p>
      <p class="text-gray-400 mt-2">Starting at $10/mo</p>
    </div>

    <div class="grid md:grid-cols-2 gap-8 mb-8">
      <div>
        <h2 class="text-xl font-bold mb-4 text-green-400">Pros</h2>
        <ul class="space-y-2">
          <li class="text-gray-300 text-sm">✅ Choose from AWS, GCP, Vultr, DO, Linode</li><li class="text-gray-300 text-sm">✅ Free SSL, staging, and CDN</li><li class="text-gray-300 text-sm">✅ 24/7 live chat support</li><li class="text-gray-300 text-sm">✅ Pay-as-you-go billing</li>
        </ul>
      </div>
      <div>
        <h2 class="text-xl font-bold mb-4 text-red-400">Cons</h2>
        <ul class="space-y-2">
          <li class="text-gray-300 text-sm">⚠️ No email hosting included</li><li class="text-gray-300 text-sm">⚠️ Can get expensive at scale</li><li class="text-gray-300 text-sm">⚠️ Learning curve for beginners</li>
        </ul>
      </div>
    </div>

    <div class="border-t border-gray-800 pt-8">
      <a href="https://www.cloudways.com/en/partners.php?id=131662" target="_blank" rel="noopener"
         class="block text-center bg-orange-600 hover:bg-orange-500 text-white px-8 py-4 rounded-lg font-bold transition">
        Sign Up via Our Affiliate Link ($50-175/sale)
      </a>
      <p class="text-center text-gray-500 text-xs mt-3">
        We earn a commission when you sign up through our link. This doesn't affect our review.
      </p>
    </div>
  </section>
</BaseLayout>
