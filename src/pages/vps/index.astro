          <div class="badge badge-orange">Popular</div>
        </div>
        <h2 class="text-xl font-bold text-white mb-2 group-hover:text-orange-400 transition-colors">Hostinger</h2>
        <p class="text-gray-500 text-sm mb-4">Starting at $3.99/mo. KVM VPS with 7 global datacenters.</p>
        <div class="flex items-center justify-between pt-4 border-t border-white/5">
          <div class="text-orange-400 font-bold">$100-150<span class="text-gray-600 text-xs font-normal">/sale</span></div>
          <div class="text-gray-500 text-sm">90 days cookie</div>
        </div>
      </a>

      <!-- CloudCone -->
      <a href="/vps/cloudcone" class="group bg-[#111] border border-white/5 rounded-2xl p-6 card-hover block">
        <div class="flex items-start justify-between mb-4">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-blue-500/20 to-blue-600/20 border border-blue-500/20 flex items-center justify-center">
            <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/>
            </svg>
          </div>
          <div class="badge badge-blue">Budget</div>
        </div>
        <h2 class="text-xl font-bold text-white mb-2 group-hover:text-orange-400 transition-colors">CloudCone</h2>
        <p class="text-gray-500 text-sm mb-4">Starting at $3.88/mo. SSD VPS with automated backups.</p>
        <div class="flex items-center justify-between pt-4 border-t border-white/5">
          <div class="text-orange-400 font-bold">$4.50<span class="text-gray-600 text-xs font-normal">/credit</span></div>
          <div class="text-gray-500 text-sm">90 days cookie</div>
        </div>
      </a>

      <!-- Aliyun -->
      <a href="/vps/aliyun" class="group bg-[#111] border border-white/5 rounded-2xl p-6 card-hover block">
        <div class="flex items-start justify-between mb-4">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-orange-500/20 to-red-500/20 border border-orange-500/20 flex items-center justify-center">
            <svg class="w-6 h-6 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/>
            </svg>
          </div>
          <div class="badge badge-orange">Enterprise</div>
        </div>
        <h2 class="text-xl font-bold text-white mb-2 group-hover:text-orange-400 transition-colors">Aliyun</h2>
        <p class="text-gray-500 text-sm mb-4">Starting at ¥34.8/mo. 26 global datacenters, China-direct.</p>
        <div class="flex items-center justify-between pt-4 border-t border-white/5">
          <div class="text-orange-400 font-bold">¥200-500<span class="text-gray-600 text-xs font-normal">/sale</span></div>
