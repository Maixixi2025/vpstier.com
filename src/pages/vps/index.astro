---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="VPS Hosting Reviews - VPSTier.com" description="Honest reviews of VPS hosting providers. Commission rates, uptime, and real-world performance for developers.">
  
  <section class="hero-gradient">
    <div class="max-w-6xl mx-auto px-6 py-16">
      <h1 class="text-4xl font-bold text-white mb-3">VPS Hosting Reviews</h1>
      <p class="text-gray-400">Honest reviews from developers who actually self-host.</p>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-12">
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      
      <!-- Interserver -->
      <a href="/vps/interserver" class="group bg-[#111] border border-white/5 rounded-2xl p-6 card-hover block">
        <div class="flex items-start justify-between mb-4">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-blue-500/20 to-blue-600/20 border border-blue-500/20 flex items-center justify-center">
            <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/>
            </svg>
          </div>
          <div class="badge badge-green">Top Pick</div>
        </div>
        <h2 class="text-xl font-bold text-white mb-2 group-hover:text-orange-400 transition-colors">Interserver</h2>
        <p class="text-gray-500 text-sm mb-4">No contracts, price lock, full root access.</p>
        <div class="flex items-center justify-between pt-4 border-t border-white/5">
          <div class="text-orange-400 font-bold">$100<span class="text-gray-600 text-xs font-normal">/sale</span></div>
          <div class="text-gray-500 text-sm">120 days cookie</div>
        </div>
      </a>

      <!-- Cloudways -->
      <a href="/vps/cloudways" class="group bg-[#111] border border-white/5 rounded-2xl p-6 card-hover block">
        <div class="flex items-start justify-between mb-4">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-purple-500/20 to-purple-600/20 border border-purple-500/20 flex items-center justify-center">
            <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/>
            </svg>
          </div>
          <div class="badge badge-orange">High Commission</div>
        </div>
        <h2 class="text-xl font-bold text-white mb-2 group-hover:text-orange-400 transition-colors">Cloudways</h2>
        <p class="text-gray-500 text-sm mb-4">Managed cloud on 5 providers. Great for teams.</p>
        <div class="flex items-center justify-between pt-4 border-t border-white/5">
          <div class="text-orange-400 font-bold">$50-175<span class="text-gray-600 text-xs font-normal">/sale</span></div>
          <div class="text-gray-500 text-sm">90 days cookie</div>
        </div>
      </a>

      <!-- Vultr -->
      <a href="/vps/vultr" class="group bg-[#111] border border-white/5 rounded-2xl p-6 card-hover block">
        <div class="flex items-start justify-between mb-4">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-green-500/20 to-green-600/20 border border-green-500/20 flex items-center justify-center">
            <svg class="w-6 h-6 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
          </div>
          <div class="badge badge-green">GPU Available</div>
        </div>
        <h2 class="text-xl font-bold text-white mb-2 group-hover:text-orange-400 transition-colors">Vultr</h2>
        <p class="text-gray-500 text-sm mb-4">Starting at $2.5/mo. GPU instances for AI.</p>
        <div class="flex items-center justify-between pt-4 border-t border-white/5">
          <div class="text-orange-400 font-bold">$10-100<span class="text-gray-600 text-xs font-normal">/sale</span></div>
          <div class="text-gray-500 text-sm">30 days cookie</div>
        </div>
      </a>

      <!-- DigitalOcean -->
      <a href="/vps/digitalocean" class="group bg-[#111] border border-white/5 rounded-2xl p-6 card-hover block">
        <div class="flex items-start justify-between mb-4">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-blue-500/20 to-blue-600/20 border border-blue-500/20 flex items-center justify-center">
            <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/>
            </svg>
          </div>
          <div class="badge badge-blue">$25 Credit</div>
        </div>
        <h2 class="text-xl font-bold text-white mb-2 group-hover:text-orange-400 transition-colors">DigitalOcean</h2>
        <p class="text-gray-500 text-sm mb-4">Starting at $4/mo. S3-compatible Spaces storage.</p>
        <div class="flex items-center justify-between pt-4 border-t border-white/5">
          <div class="text-orange-400 font-bold">$25<span class="text-gray-600 text-xs font-normal">/credit</span></div>
          <div class="text-gray-500 text-sm">90 days cookie</div>
        </div>
      </a>

      <!-- RackNerd -->
      <a href="/vps/racknerd" class="group bg-[#111] border border-white/5 rounded-2xl p-6 card-hover block">
        <div class="flex items-start justify-between mb-4">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-green-500/20 to-green-600/20 border border-green-500/20 flex items-center justify-center">
            <svg class="w-6 h-6 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/>
            </svg>
          </div>
          <div class="badge badge-green">Budget Pick</div>
