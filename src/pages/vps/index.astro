          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-teal-500/20 to-teal-600/20 border border-teal-500/20 flex items-center justify-center">
            <svg class="w-6 h-6 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
          </div>
          <div class="badge badge-blue">Budget</div>
        </div>
        <h2 class="text-xl font-bold text-white mb-2 group-hover:text-orange-400 transition-colors">YeCaoCloud</h2>
        <p class="text-gray-500 text-sm mb-4">Starting at ¥15/mo. BGP routing with Asia-Pacific focus.</p>
        <div class="flex items-center justify-between pt-4 border-t border-white/5">
