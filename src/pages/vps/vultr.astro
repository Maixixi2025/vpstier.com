---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Vultr Review - VPSTier.com" description="Vultr is a developer-favorite with 32 global locations and GPU compute options. Starting at just $2.5/mo with fast SSD storage throughout.">
  <section class="max-w-4xl mx-auto px-6 py-16">
    <a href="/vps" class="text-gray-500 hover:text-orange-500 text-sm mb-6 block">← Back to VPS Reviews</a>
    
    <div class="flex flex-wrap gap-4 items-start justify-between mb-8">
      <div>
        <h1 class="text-3xl font-bold mb-2">Vultr Review</h1>
        <div class="flex gap-4 text-sm text-gray-400">
          <span>Commission: <strong class="text-orange-500">$10-100/sale</strong></span>
          <span>Cookie: <strong>30 days</strong></span>
        </div>
      </div>
      <a href="https://www.vultr.com/?ref=9415926" target="_blank" rel="noopener" 
         class="bg-orange-600 hover:bg-orange-500 text-white px-6 py-3 rounded-lg font-medium transition">
        Visit Vultr →
      </a>
    </div>

    <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 mb-8">
      <div class="flex items-center gap-4 mb-4">
        <span class="text-2xl font-bold">4.2/5</span>
        <span class="text-gray-500">Developer Rating</span>
      </div>
      <p class="text-gray-300">Vultr is a developer-favorite with 32 global locations and GPU compute options. Starting at just $2.5/mo with fast SSD storage throughout.</p>
      <p class="text-gray-400 mt-2">Starting at $2.5/mo</p>
    </div>

    <div class="grid md:grid-cols-2 gap-8 mb-8">
      <div>
        <h2 class="text-xl font-bold mb-4 text-green-400">Pros</h2>
        <ul class="space-y-2">
          <li class="text-gray-300 text-sm">✅ Starting at $2.5/mo with SSD</li><li class="text-gray-300 text-sm">✅ GPU instances available (A100, H100)</li><li class="text-gray-300 text-sm">✅ 32 global locations</li><li class="text-gray-300 text-sm">✅ API and CLI support</li>
        </ul>
      </div>
      <div>
        <h2 class="text-xl font-bold mb-4 text-red-400">Cons</h2>
        <ul class="space-y-2">
          <li class="text-gray-300 text-sm">⚠️ 30-day cookie is shorter than competitors</li><li class="text-gray-300 text-sm">⚠️ No managed WordPress</li><li class="text-gray-300 text-sm">⚠️ Support can be slow during peak</li>
        </ul>
      </div>
    </div>

    <div class="border-t border-gray-800 pt-8">
      <a href="https://www.vultr.com/?ref=9415926" target="_blank" rel="noopener"
         class="block text-center bg-orange-600 hover:bg-orange-500 text-white px-8 py-4 rounded-lg font-bold transition">
        Sign Up via Our Affiliate Link ($10-100/sale)
      </a>
      <p class="text-center text-gray-500 text-xs mt-3">
        We earn a commission when you sign up through our link. This doesn't affect our review.
      </p>
    </div>
  </section>
</BaseLayout>
