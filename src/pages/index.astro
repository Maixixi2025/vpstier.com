---
import BaseLayout from '../layouts/BaseLayout.astro';
import fs from 'fs';
import path from 'path';

const vpsDir = path.resolve('src/pages/vps');
const vpsFiles = fs.readdirSync(vpsDir).filter(f => f.endsWith('.astro') && f !== 'index.astro');
const vpsCount = vpsFiles.length;

// Read frontmatter titles for VPS pages
const vpsPages = vpsFiles.map(f => {
  const slug = f.replace('.astro', '');
  const content = fs.readFileSync(path.join(vpsDir, f), 'utf8');
  const m = content.match(/^title:\s*["']?([^"'\n]+)/m);
  const title = m ? m[1].trim().replace(/^["']|["']$/g, '') : slug.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
  return { slug, title };
});

// Read blog frontmatter
const blogDir = path.resolve('src/pages/blog');
const blogFiles = fs.readdirSync(blogDir).filter(f => f.endsWith('.astro') && f !== 'index.astro');
const blogPosts = blogFiles.map(f => {
  const slug = f.replace('.astro', '');
  const content = fs.readFileSync(path.join(blogDir, f), 'utf8');
  const titleMatch = content.match(/^title:\s*["']?([^"'\n]+)/m);
  const dateMatch = content.match(/^pubDate:\s*["']?([^"'\n]+)/m);
  const title = titleMatch ? titleMatch[1].trim().replace(/^["']|["']$/g, '') : slug.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
  const date = dateMatch ? dateMatch[1].trim().replace(/^["']|["']$/g, '') : '';
  return { slug, title, date };
}).sort((a, b) => (b.date || '').localeCompare(a.date || ''));

// Hardcoded featured providers (kept for visual interest on hero)
const featuredProviders = [
  { slug: 'racknerd', name: 'RackNerd', tag: 'Top Pick', tagColor: 'green', icon: 'server', price: '$17.88/yr', commission: '$80-100', cookie: '45 day', desc: 'Best value VPS with 10+ North American datacenters and NVMe storage.' },
  { slug: 'vultr', name: 'Vultr', tag: 'GPU Available', tagColor: 'green', icon: 'bolt', price: '$2.5/mo', commission: '$10-100', cookie: '30 day', desc: '32 global locations, GPU instances (A100/H100), and developer-friendly API.' },
  { slug: 'digitalocean', name: 'DigitalOcean', tag: '$25 Credit', tagColor: 'blue', icon: 'cloud', price: '$4/mo', commission: '$25', cookie: '90 day', desc: 'Simple cloud with S3-compatible Spaces, clean docs, and 1-click apps.' },
  { slug: 'knownhost', name: 'KnownHost', tag: 'NVMe All Plans', tagColor: 'green', icon: 'server', price: '$5/mo', commission: '$100', cookie: '60 day', desc: 'Unmanaged NVMe VPS from $5/mo with 3 global datacenters.' },
  { slug: 'interserver', name: 'InterServer', tag: 'Price Lock', tagColor: 'orange', icon: 'server', price: '$6/mo', commission: '$100', cookie: '120 day', desc: 'No contracts, price lock guarantee, and rock-solid reliability since 1999.' },
  { slug: 'cloudways', name: 'Cloudways', tag: 'High Commission', tagColor: 'orange', icon: 'cloud', price: '$10/mo', commission: '$50-175', cookie: '90 day', desc: 'Managed cloud hosting on AWS, GCP, Vultr, DigitalOcean, and Linode.' },
];

const iconSvgs = {
  server: '<svg class="w-6 h-6 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/></svg>',
  bolt: '<svg class="w-6 h-6 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>',
  cloud: '<svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/></svg>',
};

const badgeColors = {
  green: 'badge-green',
  orange: 'badge-orange',
  blue: 'badge-blue',
};

const iconBgColors = {
  server: 'from-orange-500/20 to-orange-600/20 border-orange-500/20',
  bolt: 'from-green-500/20 to-green-600/20 border-green-500/20',
  cloud: 'from-blue-500/20 to-blue-600/20 border-blue-500/20',
};

// Split VPS into chunks of 3 for the alphabetical grid
const vpsPagesChunked: typeof vpsPages[] = [];
for (let i = 0; i < vpsPages.length; i += 3) {
  vpsPagesChunked.push(vpsPages.slice(i, i + 3));
}
---

<BaseLayout title="VPSTier.com - Best VPS Hosting for AI Agents & Developers">

  <!-- Hero -->
  <section class="hero-gradient relative overflow-hidden">
    <div class="absolute inset-0 opacity-20" style="background-image: linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px); background-size: 60px 60px;"></div>

    <div class="max-w-6xl mx-auto px-6 py-24 relative">
      <div class="max-w-3xl">
        <div class="badge badge-green mb-6 w-fit">
          <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="4"/></svg>
          Independent VPS Reviews
        </div>

        <h1 class="text-5xl md:text-6xl font-extrabold text-white mb-6 leading-tight">
          Find the
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-orange-600">
            Best VPS
          </span>
          for Your AI Agents
        </h1>

        <p class="text-xl text-gray-400 mb-10 max-w-2xl">
          Real reviews from developers who self-host AI agents and build production projects.
          Commission rates included — you know exactly what you'll earn.
        </p>

        <div class="flex flex-wrap gap-4 mb-16">
          <a href="/vps" class="btn-primary">
            Browse {vpsCount} Reviews
          </a>
          <a href="/blog" class="btn-secondary">
            Read {blogPosts.length} Articles
          </a>
          <a href="/sitemap" class="btn-secondary">
            Sitemap
          </a>
        </div>

        <!-- Stats -->
        <div class="flex flex-wrap gap-12">
          <div>
            <div class="text-3xl font-bold text-white">{vpsCount}</div>
            <div class="text-gray-500 text-sm">VPS Providers</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-white">{blogPosts.length}</div>
            <div class="text-gray-500 text-sm">Articles &amp; Guides</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-white">$50-175</div>
            <div class="text-gray-500 text-sm">Commission Range</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-white">120</div>
            <div class="text-gray-500 text-sm">Max Cookie Days</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Providers -->
  <section class="max-w-6xl mx-auto px-6 py-20">
    <div class="flex items-end justify-between mb-10">
      <div>
        <h2 class="section-heading">Top Rated VPS Providers</h2>
        <p class="section-subheading">Hand-picked by developers who actually use them.</p>
      </div>
      <a href="/vps" class="text-orange-500 hover:text-orange-400 text-sm font-medium transition-colors">
        View all {vpsCount} →
      </a>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {featuredProviders.map((p) => (
        <a href={`/vps/${p.slug}`} class="group bg-[#111] border border-white/5 rounded-2xl p-6 card-hover block">
          <div class="flex items-start justify-between mb-5">
            <div class={`w-12 h-12 rounded-xl bg-gradient-to-br ${iconBgColors[p.icon]} flex items-center justify-center`} set:html={iconSvgs[p.icon]} />
            <div class={`${badgeColors[p.tagColor]}`}>
              <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="4"/></svg>
              {p.tag}
            </div>
          </div>

          <h3 class="text-xl font-bold text-white mb-2 group-hover:text-orange-400 transition-colors">{p.name}</h3>
          <p class="text-gray-500 text-sm mb-4">{p.desc}</p>

          <div class="flex items-center justify-between pt-4 border-t border-white/5">
            <div>
              <div class="text-orange-400 font-bold text-lg">{p.commission}<span class="text-gray-500 text-xs font-normal">/sale</span></div>
              <div class="text-gray-600 text-xs">{p.cookie}</div>
            </div>
            <div class="text-gray-400 text-sm">from <span class="text-white font-medium">{p.price}</span></div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Latest Articles (dynamic) -->
  <section class="border-t border-white/5">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <div class="flex items-end justify-between mb-10">
        <div>
          <h2 class="section-heading">Latest Articles &amp; Guides</h2>
          <p class="section-subheading">{blogPosts.length} reviews, comparisons, and buying guides.</p>
        </div>
        <a href="/blog" class="text-orange-500 hover:text-orange-400 text-sm font-medium transition-colors">
          View all →
        </a>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {blogPosts.slice(0, 12).map((post) => (
          <a href={`/blog/${post.slug}`} class="group bg-[#111] border border-white/5 rounded-2xl p-6 card-hover block">
            <h3 class="text-base font-bold text-white mb-2 group-hover:text-orange-400 transition-colors">
              {post.title}
            </h3>
            {post.date && <div class="text-gray-600 text-xs mt-3">{post.date}</div>}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- All VPS Providers (NEW — full list for SEO) -->
  <section class="border-t border-white/5">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <div class="flex items-end justify-between mb-10">
        <div>
          <h2 class="section-heading">All VPS Provider Reviews</h2>
          <p class="section-subheading">{vpsCount} providers reviewed. Pick the one that fits your workload.</p>
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
        {vpsPages.map((p) => (
          <a href={`/vps/${p.slug}`} class="group flex items-center gap-2 text-gray-400 hover:text-orange-400 transition-colors py-1.5">
            <svg class="w-3.5 h-3.5 text-orange-500/60 group-hover:text-orange-400 flex-shrink-0" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3"/></svg>
            <span class="text-sm">{p.title}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- All Articles (NEW — full list for SEO) -->
  <section class="border-t border-white/5">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <div class="flex items-end justify-between mb-10">
        <div>
          <h2 class="section-heading">All Articles &amp; Reviews</h2>
          <p class="section-subheading">{blogPosts.length} articles. VPS reviews, buying guides, outage postmortems.</p>
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
        {blogPosts.map((post) => (
          <a href={`/blog/${post.slug}`} class="group flex items-center gap-2 text-gray-400 hover:text-orange-400 transition-colors py-1.5">
            <svg class="w-3.5 h-3.5 text-orange-500/60 group-hover:text-orange-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <span class="text-sm">{post.title}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Trust Us -->
  <section class="border-t border-white/5">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="section-heading mb-4">Why Trust VPSTier?</h2>
          <p class="text-gray-400 mb-8">
            We use these VPS providers ourselves for AI agent deployments, side projects, and client work.
            Every review is based on real usage — not copied from marketing materials.
          </p>
          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-orange-500/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <div>
                <div class="text-white font-medium">Real commission data</div>
                <div class="text-gray-500 text-sm">We show actual affiliate commission rates — no hidden recaps.</div>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-orange-500/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <div>
                <div class="text-white font-medium">Tested by developers</div>
                <div class="text-gray-500 text-sm">SSH access, API, pricing — we verify what matters to you.</div>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-orange-500/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <div>
                <div class="text-white font-medium">Updated quarterly</div>
                <div class="text-gray-500 text-sm">Prices and commissions are verified every 3 months.</div>
              </div>
            </div>
          </div>
        </div>
        <div class="bg-gradient-to-br from-orange-500/10 to-orange-600/5 border border-orange-500/20 rounded-2xl p-8">
          <div class="text-orange-400 font-semibold text-sm mb-4">COMMISSION DISCLOSURE</div>
          <p class="text-gray-300 text-sm leading-relaxed">
            VPSTier.com is an independent review site. We earn commissions from VPS providers when you sign up through our links.
            This does not affect our reviews or rankings. We only recommend products we believe in.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="hero-gradient border-t border-white/5">
    <div class="max-w-4xl mx-auto px-6 py-20 text-center">
      <h2 class="text-3xl font-bold text-white mb-4">Ready to find your VPS?</h2>
      <p class="text-gray-400 mb-8">Browse our hand-picked reviews and start hosting today.</p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/vps" class="btn-primary">
          View {vpsCount} VPS Reviews
        </a>
        <a href="/sitemap" class="btn-secondary">
          See Full Sitemap
        </a>
      </div>
    </div>
  </section>
</BaseLayout>