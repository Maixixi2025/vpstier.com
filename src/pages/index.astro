---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="VPSTier.com - Best VPS Hosting for AI Agents & Developers">
  
  <!-- Hero -->
  <section class="hero-gradient relative overflow-hidden">
    <!-- Grid pattern -->
    <div class="absolute inset-0 opacity-20" style="background-image: linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px); background-size: 60px 60px;"></div>
    
    <div class="max-w-6xl mx-auto px-6 py-24 relative">
      <div class="max-w-3xl">
        <div class="badge badge-green mb-6 w-fit">
          <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="4"/></svg>
          Independent VPS Reviews
        </div>
        
        <h1 class="text-5xl md:text-6xl font-extrabold text-white mb-6 leading-tight">
          Find the 
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-orange-600">
            Best VPS
          </span>
          for Your AI Agents
        </h1>
        
        <p class="text-xl text-gray-400 mb-10 max-w-2xl">
          Real reviews from developers who self-host AI agents and build production projects. 
          Commission rates included — you know exactly what you'll earn.
        </p>
        
        <div class="flex flex-wrap gap-4 mb-16">
          <a href="/vps" class="btn-primary">
            Browse Reviews
          </a>
          <a href="/compare" class="btn-secondary">
            Compare Plans
          </a>
        </div>
        
        <!-- Stats -->
        <div class="flex flex-wrap gap-12">
          <div>
            <div class="text-3xl font-bold text-white">4</div>
            <div class="text-gray-500 text-sm">VPS Providers</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-white">$50-175</div>
            <div class="text-gray-500 text-sm">Commission Range</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-white">120</div>
            <div class="text-gray-500 text-sm">Max Cookie Days</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-white">100%</div>
            <div class="text-gray-500 text-sm">Independent Reviews</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Providers -->
  <section class="max-w-6xl mx-auto px-6 py-20">
    <div class="flex items-end justify-between mb-10">
      <div>
        <h2 class="section-heading">Top Rated VPS Providers</h2>
        <p class="section-subheading">Hand-picked by developers who actually use them.</p>
      </div>
      <a href="/vps" class="text-orange-500 hover:text-orange-400 text-sm font-medium transition-colors">
        View all →
      </a>
    </div>
    
    <div class="grid md:grid-cols-3 gap-6">
      <!-- Interserver -->
      <a href="/vps/interserver" class="group bg-[#111] border border-white/5 rounded-2xl p-6 card-hover block">
        <div class="flex items-start justify-between mb-5">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-blue-500/20 to-blue-600/20 border border-blue-500/20 flex items-center justify-center">
            <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/>
            </svg>
          </div>
          <div class="badge badge-green">
            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="4"/></svg>
            Top Pick
          </div>
        </div>
        
        <h3 class="text-xl font-bold text-white mb-2 group-hover:text-orange-400 transition-colors">Interserver</h3>
        <p class="text-gray-500 text-sm mb-4">No contracts, price lock guarantee, and rock-solid reliability since 1999.</p>
        
        <div class="flex items-center justify-between pt-4 border-t border-white/5">
          <div>
            <div class="text-orange-400 font-bold text-lg">$100<span class="text-gray-500 text-xs font-normal">/sale</span></div>
            <div class="text-gray-600 text-xs">120 day cookie</div>
          </div>
          <div class="text-gray-400 text-sm">from <span class="text-white font-medium">$6/mo</span></div>
        </div>
      </a>

      <!-- Cloudways -->
      <a href="/vps/cloudways" class="group bg-[#111] border border-white/5 rounded-2xl p-6 card-hover block">
        <div class="flex items-start justify-between mb-5">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-purple-500/20 to-purple-600/20 border border-purple-500/20 flex items-center justify-center">
            <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/>
            </svg>
          </div>
          <div class="badge badge-orange">
            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="4"/></svg>
            High Commission
          </div>
        </div>
        
        <h3 class="text-xl font-bold text-white mb-2 group-hover:text-orange-400 transition-colors">Cloudways</h3>
        <p class="text-gray-500 text-sm mb-4">Managed cloud hosting on AWS, GCP, Vultr, DigitalOcean, and Linode.</p>
        
        <div class="flex items-center justify-between pt-4 border-t border-white/5">
          <div>
            <div class="text-orange-400 font-bold text-lg">$50-175<span class="text-gray-500 text-xs font-normal">/sale</span></div>
            <div class="text-gray-600 text-xs">90 day cookie</div>
          </div>
          <div class="text-gray-400 text-sm">from <span class="text-white font-medium">$10/mo</span></div>
        </div>
      </a>

      <!-- Vultr -->
      <a href="/vps/vultr" class="group bg-[#111] border border-white/5 rounded-2xl p-6 card-hover block">
        <div class="flex items-start justify-between mb-5">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-green-500/20 to-green-600/20 border border-green-500/20 flex items-center justify-center">
            <svg class="w-6 h-6 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
          </div>
          <div class="badge badge-green">
            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="4"/></svg>
            GPU Available
          </div>
        </div>
        
        <h3 class="text-xl font-bold text-white mb-2 group-hover:text-orange-400 transition-colors">Vultr</h3>
        <p class="text-gray-500 text-sm mb-4">32 global locations, GPU instances (A100/H100), and developer-friendly API.</p>
        
        <div class="flex items-center justify-between pt-4 border-t border-white/5">
          <div>
            <div class="text-orange-400 font-bold text-lg">$10-100<span class="text-gray-500 text-xs font-normal">/sale</span></div>
            <div class="text-gray-600 text-xs">30 day cookie</div>
          </div>
          <div class="text-gray-400 text-sm">from <span class="text-white font-medium">$2.5/mo</span></div>
        </div>
      </a>

      <!-- DigitalOcean -->
      <a href="/vps/digitalocean" class="group bg-[#111] border border-white/5 rounded-2xl p-6 card-hover block">
        <div class="flex items-start justify-between mb-5">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-blue-500/20 to-blue-600/20 border border-blue-500/20 flex items-center justify-center">
            <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/>
            </svg>
          </div>
          <div class="badge badge-blue">
            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="4"/></svg>
            $25 Credit
          </div>
        </div>
        
        <h3 class="text-xl font-bold text-white mb-2 group-hover:text-orange-400 transition-colors">DigitalOcean</h3>
        <p class="text-gray-500 text-sm mb-4">Simple cloud with S3-compatible Spaces, clean docs, and 1-click Marketplace apps.</p>
        
        <div class="flex items-center justify-between pt-4 border-t border-white/5">
          <div>
            <div class="text-orange-400 font-bold text-lg">$25<span class="text-gray-500 text-xs font-normal">/credit</span></div>
            <div class="text-gray-600 text-xs">90 day cookie</div>
          </div>
          <div class="text-gray-400 text-sm">from <span class="text-white font-medium">$4/mo</span></div>
        </div>
      </a>
    </div>
  </section>

  <!-- Latest Articles -->
  <section class="border-t border-white/5">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <div class="flex items-end justify-between mb-10">
        <div>
          <h2 class="section-heading">Latest Articles</h2>
          <p class="section-subheading">Weekly VPS comparisons and commission benchmarks.</p>
        </div>
        <a href="/blog" class="text-orange-500 hover:text-orange-400 text-sm font-medium transition-colors">
          View all →
        </a>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <a href="/blog/racknerd-vs-vultr-2025" class="group bg-[#111] border border-white/5 rounded-2xl p-6 card-hover block">
          <div class="flex items-center gap-2 mb-3">
            <span class="badge badge-orange text-xs">Comparison</span>
            <span class="text-gray-600 text-xs">May 21, 2025</span>
          </div>
          <h3 class="text-base font-bold text-white mb-2 group-hover:text-orange-400 transition-colors">
            RackNerd vs Vultr: Which VPS is Better for AI Agents
          </h3>
          <p class="text-gray-500 text-sm line-clamp-2">
            Deep dive comparison focusing on AI agent workloads. CPU PassMark, network latency, and real inference speeds tested.
          </p>
        </a>
        <a href="/blog/cloudways-vs-digitalocean-2025" class="group bg-[#111] border border-white/5 rounded-2xl p-6 card-hover block">
          <div class="flex items-center gap-2 mb-3">
            <span class="badge badge-blue text-xs">Comparison</span>
            <span class="text-gray-600 text-xs">May 20, 2025</span>
          </div>
          <h3 class="text-base font-bold text-white mb-2 group-hover:text-orange-400 transition-colors">
            Cloudways vs DigitalOcean: Managed vs Unmanaged
          </h3>
          <p class="text-gray-500 text-sm line-clamp-2">
            Cloudways offers managed hosting while DigitalOcean gives raw infrastructure. Which is better for beginners?
          </p>
        </a>
      </div>
    </div>
  </section>

  <!-- Why Trust Us -->
  <section class="border-t border-white/5">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="section-heading mb-4">Why Trust VPSTier?</h2>
          <p class="text-gray-400 mb-8">
            We use these VPS providers ourselves for AI agent deployments, side projects, and client work. 
            Every review is based on real usage — not copied from marketing materials.
          </p>
          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-orange-500/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <div>
                <div class="text-white font-medium">Real commission data</div>
                <div class="text-gray-500 text-sm">We show actual affiliate commission rates — no hidden recaps.</div>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-orange-500/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <div>
                <div class="text-white font-medium">Tested by developers</div>
                <div class="text-gray-500 text-sm">SSH access, API, pricing — we verify what matters to you.</div>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-orange-500/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <div>
                <div class="text-white font-medium">Updated quarterly</div>
                <div class="text-gray-500 text-sm">Prices and commissions are verified every 3 months.</div>
              </div>
            </div>
          </div>
        </div>
        <div class="bg-gradient-to-br from-orange-500/10 to-orange-600/5 border border-orange-500/20 rounded-2xl p-8">
          <div class="text-orange-400 font-semibold text-sm mb-4">COMMISSION DISCLOSURE</div>
          <p class="text-gray-300 text-sm leading-relaxed">
            VPSTier.com is an independent review site. We earn commissions from VPS providers when you sign up through our links. 
            This does not affect our reviews or rankings. We only recommend products we believe in.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="hero-gradient border-t border-white/5">
    <div class="max-w-4xl mx-auto px-6 py-20 text-center">
      <h2 class="text-3xl font-bold text-white mb-4">Ready to find your VPS?</h2>
      <p class="text-gray-400 mb-8">Browse our hand-picked reviews and start hosting today.</p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/vps" class="btn-primary">
          View VPS Reviews
        </a>
        <a href="/compare" class="btn-secondary">
          Compare Plans
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
