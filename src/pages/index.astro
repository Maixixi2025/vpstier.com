---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="VPSTier.com - Best VPS Hosting for AI Agents & Developers">
  <section class="max-w-6xl mx-auto px-6 py-20 text-center">
    <h1 class="text-4xl md:text-5xl font-bold mb-6">
      Find the <span class="text-orange-500">Best VPS</span> for Your Project
    </h1>
    <p class="text-gray-400 text-lg max-w-2xl mx-auto mb-10">
      Real reviews from developers who actually self-host AI agents, build projects, and need reliable infrastructure at honest prices.
    </p>
    <div class="flex gap-4 justify-center">
      <a href="/vps" class="bg-orange-600 hover:bg-orange-500 text-white px-6 py-3 rounded-lg font-medium transition">
        Browse VPS Reviews
      </a>
      <a href="/compare" class="border border-gray-600 hover:border-gray-400 px-6 py-3 rounded-lg font-medium transition">
        Compare Plans
      </a>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-16">
    <h2 class="text-2xl font-bold mb-8">Top Rated VPS Providers</h2>
    <div class="grid md:grid-cols-3 gap-6">
      <div class="bg-gray-900 border border-gray-800 rounded-xl p-6">
        <div class="text-orange-500 font-bold text-xl mb-2">Interserver</div>
        <p class="text-sm text-gray-400 mb-4">$100 per sale • 120 day cookie</p>
        <p class="text-gray-300 text-sm mb-4">Linux & Windows VPS from $6/mo. No hidden fees, full root access.</p>
        <a href="/vps/interserver" class="text-orange-500 hover:text-orange-400 text-sm font-medium">Read Review →</a>
      </div>
      <div class="bg-gray-900 border border-gray-800 rounded-xl p-6">
        <div class="text-orange-500 font-bold text-xl mb-2">Cloudways</div>
        <p class="text-sm text-gray-400 mb-4">$50-175 per sale • 90 day cookie</p>
        <p class="text-gray-300 text-sm mb-4">Managed cloud hosting. Launch on AWS, GCP, Vultr, DO, or Linode in minutes.</p>
        <a href="/vps/cloudways" class="text-orange-500 hover:text-orange-400 text-sm font-medium">Read Review →</a>
      </div>
      <div class="bg-gray-900 border border-gray-800 rounded-xl p-6">
        <div class="text-orange-500 font-bold text-xl mb-2">Vultr</div>
        <p class="text-sm text-gray-400 mb-4">$10-100 per sale • 30 day cookie</p>
        <p class="text-gray-300 text-sm mb-4">Global network, fast SSD, starting at $2.5/mo. GPU instances available.</p>
        <a href="/vps/vultr" class="text-orange-500 hover:text-orange-400 text-sm font-medium">Read Review →</a>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-16 border-t border-gray-800">
    <h2 class="text-2xl font-bold mb-4">Why Trust VPSTier?</h2>
    <p class="text-gray-400 max-w-2xl">
      We use these VPS providers ourselves for AI agent deployments, side projects, and client work. 
      Every review includes real commission rates so you know exactly what you'll earn if you promote them.
    </p>
  </section>
</BaseLayout>
