---
import BaseLayout from './BaseLayout.astro';
const { frontmatter } = Astro.props;
---
<BaseLayout title={`${frontmatter.title} - VPSTier.com`}>
  <section class="hero-gradient border-b border-white/5">
    <div class="max-w-4xl mx-auto px-6 py-16">
      <a href="/blog" class="text-orange-500 hover:text-orange-400 text-sm mb-6 block">← Back to Blog</a>
      <div class="flex items-center gap-3 mb-4">
        <span class="badge badge-orange">{frontmatter.category}</span>
        <span class="text-gray-500 text-sm">{frontmatter.date}</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">{frontmatter.title}</h1>
      <p class="text-gray-400 text-lg mb-6">{frontmatter.excerpt}</p>
      <div class="flex flex-wrap gap-2">
        {frontmatter.tags.map(tag => (
          <span class="text-xs text-gray-400 bg-white/5 px-3 py-1 rounded-full border border-white/10">{tag}</span>
        ))}
      </div>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 py-16">
    <article class="prose prose-invert prose-orange max-w-none">
      <slot />
    </article>
  </section>
</BaseLayout>
