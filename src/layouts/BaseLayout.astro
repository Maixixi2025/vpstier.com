---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Find the best VPS hosting for AI agents and self-hosted projects. Real reviews, real commission rates." } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={Astro.url.href} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={Astro.url.href} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content="VPSTier.com" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <!-- JSON-LD: WebSite + Organization -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "VPSTier.com",
    "url": "https://vpstier.com",
    "description": "Find the best VPS hosting for AI agents and self-hosted projects. Real reviews, real commission rates.",
    "sameAs": [
      "https://twitter.com/vpstier"
    ]
  })} />
</head>
<body class="font-['Inter'] bg-[#0a0a0a] text-gray-100 antialiased">
  <!-- Header -->
  <header class="sticky top-0 z-50 bg-[#0a0a0a]/80 backdrop-blur-xl border-b border-white/5">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex items-center justify-between h-16">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-orange-500 to-orange-600 flex items-center justify-center">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/>
            </svg>
          </div>
          <span class="font-bold text-lg text-white">VPSTier<span class="text-orange-500">.com</span></span>
        </a>
        
        <!-- Nav -->
        <nav class="hidden md:flex items-center gap-8">
          <a href="/vps" class="text-sm text-gray-400 hover:text-white transition-colors">VPS Reviews</a>
          <a href="/compare" class="text-sm text-gray-400 hover:text-white transition-colors">Compare</a>
        </nav>
        
        <!-- CTA -->
        <a href="/vps/interserver" class="btn-primary text-sm py-2 px-4">
          Start Hosting →
        </a>
      </div>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <!-- Footer -->
  <footer class="border-t border-white/5 mt-20">
    <div class="max-w-6xl mx-auto px-6 py-12">
      <div class="flex flex-col md:flex-row justify-between items-start gap-8">
        <div>
          <a href="/" class="flex items-center gap-2 mb-4">
            <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-orange-500 to-orange-600 flex items-center justify-center">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/>
              </svg>
            </div>
            <span class="font-bold text-white">VPSTier<span class="text-orange-500">.com</span></span>
          </a>
          <p class="text-gray-500 text-sm max-w-xs">
            Independent VPS reviews by developers, for developers. Commission earnings support this site.
          </p>
        </div>
        <div class="flex gap-16 text-sm">
          <div>
            <h4 class="text-white font-medium mb-4">Reviews</h4>
            <ul class="space-y-2 text-gray-400">
              <li><a href="/vps/interserver" class="hover:text-white transition-colors">Interserver</a></li>
              <li><a href="/vps/cloudways" class="hover:text-white transition-colors">Cloudways</a></li>
              <li><a href="/vps/vultr" class="hover:text-white transition-colors">Vultr</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-white font-medium mb-4">Resources</h4>
            <ul class="space-y-2 text-gray-400">
              <li><a href="/compare" class="hover:text-white transition-colors">Compare VPS</a></li>
            </ul>
          </div>
        </div>
      </div>
      <div class="border-t border-white/5 mt-12 pt-8 text-center text-gray-600 text-sm">
        <p>© 2026 VPSTier.com — Affiliate reviews. We may earn a commission at no extra cost to you.</p>
      </div>
    </div>
  </footer>
</body>
</html>
