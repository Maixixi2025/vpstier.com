---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Find the best VPS hosting for AI agents and self-hosted projects. Real reviews, real commission rates." } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={Astro.url.href} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={Astro.url.href} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content="VPSTier.com" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <!-- JSON-LD: WebSite + Organization -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "VPSTier.com",
    "url": "https://vpstier.com",
    "description": "Find the best VPS hosting for AI agents and self-hosted projects. Real reviews, real commission rates.",
    "publisher": {
      "@type": "Organization",
      "name": "VPSTier.com",
      "url": "https://vpstier.com",
      "founder": {
        "@type": "Person",
        "name": "Jason Mai",
        "url": "https://about.me/jasonxmai"
      },
      "sameAs": [
        "https://twitter.com/vpstier",
        "https://about.me/jasonxmai"
      ]
    },
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://vpstier.com/blog/?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  })} />

  <!-- JSON-LD: FAQPage (top VPS questions) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is the best VPS for AI agents in 2026?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "For AI agents and long-running workloads, Hetzner Cloud (CCX/CPX) and Vultr High Performance are the top picks based on cost-per-vCPU. Budget options like RackNerd and BandwagonHost work for lighter workloads. See our VPS reviews for benchmarks."
        }
      },
      {
        "@type": "Question",
        "name": "How much does a VPS cost per month?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "VPS prices range from $5/month for budget providers (RackNerd, BandwagonHost) to $50+/month for managed cloud (Cloudways, DigitalOcean). The sweet spot for most developers is $10-25/month for 2-4 vCPU and 4-8 GB RAM."
        }
      },
      {
        "@type": "Question",
        "name": "What's the difference between VPS and shared hosting?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "VPS gives you dedicated CPU/RAM/disk in an isolated virtual environment. Shared hosting runs hundreds of sites on one server. VPS is faster, more secure, and more customizable, but costs more. For AI agents, APIs, or any production workload, VPS is required."
        }
      },
      {
        "@type": "Question",
        "name": "Which VPS has the best renewal pricing transparency?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Vultr, DigitalOcean, Linode, and Hetzner all show renewal prices upfront (same as intro). Hosts with steep renewal hikes include Bluehost, HostGator, and GoDaddy. VPSTier tracks renewal-vs-intro pricing on every provider page."
        }
      },
      {
        "@type": "Question",
        "name": "Do you earn commission from VPS providers?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, VPSTier uses affiliate links. When you click a provider link and purchase, we may earn a commission at no extra cost to you. Affiliate relationships never affect our ranking or review content. All rankings are based on benchmark data, pricing, and reliability."
        }
      }
    ]
  })} />
</head>
<body class="font-['Inter'] bg-[#0a0a0a] text-gray-100 antialiased">
  <!-- Header -->
  <header class="sticky top-0 z-50 bg-[#0a0a0a]/80 backdrop-blur-xl border-b border-white/5">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex items-center justify-between h-16">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-orange-500 to-orange-600 flex items-center justify-center">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/>
            </svg>
          </div>
          <span class="font-bold text-lg text-white">VPSTier<span class="text-orange-500">.com</span></span>
        </a>
        
        <!-- Nav -->
        <nav class="hidden md:flex items-center gap-8">
          <a href="/vps" class="text-sm text-gray-400 hover:text-white transition-colors">VPS Reviews</a>
          <a href="/compare" class="text-sm text-gray-400 hover:text-white transition-colors">Compare</a>
          <a href="/blog" class="text-sm text-gray-400 hover:text-white transition-colors">Blog</a>
          <a href="/about" class="text-sm text-gray-400 hover:text-white transition-colors">About</a>
          <a href="/privacy" class="text-sm text-gray-400 hover:text-white transition-colors">Privacy</a>
        </nav>
        
        <!-- CTA -->
        <a href="/vps/interserver" class="btn-primary text-sm py-2 px-4">
          Start Hosting →
        </a>
      </div>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <!-- Footer -->
  <footer class="border-t border-white/5 mt-20">
    <div class="max-w-6xl mx-auto px-6 py-12">
      <div class="flex flex-col md:flex-row justify-between items-start gap-8">
        <div>
          <a href="/" class="flex items-center gap-2 mb-4">
            <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-orange-500 to-orange-600 flex items-center justify-center">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/>
              </svg>
            </div>
            <span class="font-bold text-white">VPSTier<span class="text-orange-500">.com</span></span>
          </a>
          <p class="text-gray-500 text-sm max-w-xs">
            Independent VPS reviews by developers, for developers. Commission earnings support this site.
          </p>
        </div>
        <div class="flex gap-16 text-sm">
          <div>
            <h4 class="text-white font-medium mb-4">Reviews</h4>
            <ul class="space-y-2 text-gray-400">
              <li><a href="/vps/interserver" class="hover:text-white transition-colors">Interserver</a></li>
              <li><a href="/vps/cloudways" class="hover:text-white transition-colors">Cloudways</a></li>
              <li><a href="/vps/vultr" class="hover:text-white transition-colors">Vultr</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-white font-medium mb-4">Resources</h4>
            <ul class="space-y-2 text-gray-400">
              <li><a href="/compare" class="hover:text-white transition-colors">Compare VPS</a></li>
              <li><a href="/about" class="hover:text-white transition-colors">About</a></li>
              <li><a href="/privacy" class="hover:text-white transition-colors">Privacy</a></li>
              <li><a href="https://about.me/jasonxmai" rel="me noopener" target="_blank" class="hover:text-white transition-colors">About the Author</a></li>
            </ul>
          </div>
        </div>
      </div>
      <div class="border-t border-white/5 mt-12 pt-8 text-center text-gray-600 text-sm">
        <p>© 2026 VPSTier.com — Affiliate reviews. We may earn a commission at no extra cost to you.</p>
      </div>
    </div>
  </footer>
</body>
</html>
